rules_version = '2';

// ===============================================================
// Fruta Clear 3D — Authoritative Firestore Security Rules
// ===============================================================
//
// Collections:
// 1. /users/{userId}: Player profile, cosmetics inventory, and bounded economy fallback
// 2. /leaderboard/{userId}: Server-authoritative leaderboard (written only by Cloud Functions)
// 3. /recoveryCodes/{code}: Single-use recovery tokens (FC3D-XXXX-XXXX)
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidUser(data) {
      return hasOnlyAllowedFields([
               'username',
               'highScore',
               'currentLevel',
               'coins',
               'activeSkin',
               'activeBackground',
               'unlockedSkins',
               'unlockedBackgrounds',
               'lastMissionClaimKey',
               'restoredFromCode',
               'createdAt',
               'updatedAt'
             ]) &&
             hasRequiredFields([
               'username',
               'highScore',
               'currentLevel',
               'coins',
               'createdAt',
               'updatedAt'
             ]) &&
             data.username is string &&
             data.username.size() >= 1 &&
             data.username.size() <= 30 &&
             data.highScore is number &&
             data.highScore >= 0 &&
             data.highScore <= 1000000000 &&
             data.currentLevel is number &&
             data.currentLevel >= 1 &&
             data.currentLevel <= 100000 &&
             data.coins is number &&
             data.coins >= 0 &&
             data.coins <= 1000000000 &&
             (!('activeSkin' in data) || (data.activeSkin is string && data.activeSkin.size() >= 1 && data.activeSkin.size() <= 50)) &&
             (!('activeBackground' in data) || (data.activeBackground is string && data.activeBackground.size() >= 1 && data.activeBackground.size() <= 50)) &&
             (!('unlockedSkins' in data) || (data.unlockedSkins is list && data.unlockedSkins.size() >= 1 && data.unlockedSkins.size() <= 100)) &&
             (!('unlockedBackgrounds' in data) || (data.unlockedBackgrounds is list && data.unlockedBackgrounds.size() >= 1 && data.unlockedBackgrounds.size() <= 100)) &&
             (!('activeSkin' in data && 'unlockedSkins' in data) || (data.activeSkin in data.unlockedSkins)) &&
             (!('activeBackground' in data && 'unlockedBackgrounds' in data) || (data.activeBackground in data.unlockedBackgrounds)) &&
             (!('lastMissionClaimKey' in data) || (data.lastMissionClaimKey is string && data.lastMissionClaimKey.size() <= 64)) &&
             (!('restoredFromCode' in data) || (data.restoredFromCode is string && data.restoredFromCode.size() == 14)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Strict initial creation: new accounts start at level 1 with 0 coins (unless restoring a valid 1-use code)
    function isValidInitialEconomy(data) {
      return (data.coins == 0 && data.currentLevel == 1 && data.highScore == 0) ||
             ('restoredFromCode' in data && data.restoredFromCode is string && data.restoredFromCode.size() == 14);
    }

    // Strict per-action economy transition (no arbitrary +250 coin farming per request):
    // - Level win (+1 level): max +10 coins
    // - Daily mission claim (new lastMissionClaimKey): max +45 coins
    // - Single-use recovery redemption (new restoredFromCode): matches redeemed code snapshot
    // - All other profile updates (cosmetics, spend coins, username): coins cannot increase
    function isValidEconomyUpdate(oldData, newData) {
      let isLevelAdvance = newData.currentLevel == oldData.currentLevel + 1 &&
                           newData.highScore >= oldData.highScore &&
                           newData.highScore <= oldData.highScore + 15000 &&
                           newData.coins <= oldData.coins + 10;

      let isMissionClaim = newData.currentLevel == oldData.currentLevel &&
                           ('lastMissionClaimKey' in newData) &&
                           (!('lastMissionClaimKey' in oldData) || newData.lastMissionClaimKey != oldData.lastMissionClaimKey) &&
                           newData.coins <= oldData.coins + 45;

      let isRecoveryRedeem = ('restoredFromCode' in newData) &&
                             (!('restoredFromCode' in oldData) || newData.restoredFromCode != oldData.restoredFromCode);

      let isNonMintUpdate = newData.currentLevel == oldData.currentLevel &&
                            newData.highScore >= oldData.highScore &&
                            newData.highScore <= oldData.highScore + 15000 &&
                            newData.coins <= oldData.coins;

      return isLevelAdvance || isMissionClaim || isRecoveryRedeem || isNonMintUpdate;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId) &&
                       isValidUser(request.resource.data) &&
                       isValidInitialEconomy(request.resource.data) &&
                       request.resource.data.createdAt <= request.time;

      allow update: if isOwner(userId) &&
                       isValidUser(request.resource.data) &&
                       isValidEconomyUpdate(resource.data, request.resource.data) &&
                       areImmutableFieldsUnchanged(['createdAt']);

      allow delete: if false;

      match /missionClaims/{claimId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         request.resource.data.rewardCoins in [15, 20, 25, 30, 45];
        allow update, delete: if false;
      }
    }

    // Authoritative Leaderboard Collection (write-once / server-side via Cloud Functions only)
    match /leaderboard/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Single-Use Recovery Codes Collection (P0-1)
    match /recoveryCodes/{code} {
      allow get: if isAuthenticated() && code.size() == 14;
      allow list: if false;

      // Owner can generate a fresh unused recovery code for their own UID
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       request.resource.data.used == false &&
                       request.resource.data.code == code &&
                       code.size() == 14;

      // Single-use redemption: can only transition from used == false to used == true once
      allow update: if isAuthenticated() &&
                       resource.data.used == false &&
                       request.resource.data.used == true &&
                       request.resource.data.redeemedBy == request.auth.uid &&
                       areImmutableFieldsUnchanged(['ownerUid', 'snapshot', 'code', 'createdAt']);

      allow delete: if false;
    }
  }
}
